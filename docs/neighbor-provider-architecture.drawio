        <mxCell id="title" value="Neighbor Search Provider 架构 · search / fusion 统一层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#1c1c1a;fontFamily=Helvetica;" vertex="1" parent="1">
