        </mxCell>
        <mxCell id="subtitle" value="核心边界：Provider 只检索并产出 NeighborCandidate；Fusion 只做多 channel 排名融合；Hypothesis 只读 FusedCandidate，不直接调用任何 provider。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#5f5e5a;fontFamily=Helvetica;" vertex="1" parent="1">
