                    // 处理 AI 响应
                    if (data.action === 'add_tools' && data.tools && data.tools.length > 0) {
                        console.log('[Plan Builder] Adding tools:', data.tools);
                        data.tools.forEach(toolName => {
                            if (!currentPipeline.some(p => p.name === toolName)) {
