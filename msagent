<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSAgent - AI Mass Spectrometry Analysis</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/cytoscape@3.28.1/dist/cytoscape.min.js"></script>
    <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js"></script>
    <script src="https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js"></script>
    <!-- Sortable.js for drag-and-drop pipeline reordering -->
    <script src="https://unpkg.com/sortablejs@1.15.2/Sortable.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #f8f9fa;
            min-height: 100vh;
            color: #2c3e50;
            font-size: 14px;
            line-height: 1.6;
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 12px 24px;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ========== Header ========== */
        .header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 20px;
            background: white;
            border-bottom: 2px solid #3366cc;
            border-radius: 4px;
            margin-bottom: 12px;
        }

        .header h1 {
            font-size: 1.2em;
            font-weight: 700;
            color: #1a1a2e;
        }

        .header-spacer { flex: 1; }

        /* 用户登录区域 */
        .user-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-area input {
            padding: 6px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 12px;
            width: 140px;
        }

        .user-area .btn-login {
            padding: 6px 14px;
            background: #3366cc;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
        }

        .user-area .btn-login:hover { background: #2851a3; }

        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: #e7f3ff;
            border-radius: 4px;
            font-size: 12px;
        }

        .user-info .username {
            font-weight: 600;
            color: #3366cc;
        }

        .user-info .btn-logout {
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            font-size: 11px;
        }

        .user-info .btn-logout:hover { color: #dc3545; }

        /* ========== Lab Link ========== */
        .lab-link {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .lab-link:hover { 
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.4);
        }
        .lab-link svg { width: 14px; height: 14px; }

        /* ========== Footer ========== */
        .site-footer {
            background: white;
            border-top: 2px solid #3366cc;
            color: #6c757d;
            padding: 10px 20px;
            font-size: 11px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 4px;
            margin-top: 12px;
            flex-shrink: 0;
        }
        .footer-left { display: flex; align-items: center; gap: 20px; }
        .footer-left .lab-name {
            color: #1a1a2e;
            font-weight: 600;
            font-size: 12px;
        }
        .footer-left .lab-name a {
            color: #3366cc;
            text-decoration: none;
        }
        .footer-left .lab-name a:hover { text-decoration: underline; color: #2851a3; }
        .footer-contact { display: flex; gap: 16px; color: #495057; }
        .footer-contact span { display: flex; align-items: center; gap: 4px; }
        .footer-right { 
            color: #868e96;
            font-size: 10px;
            font-style: italic;
        }
        .footer-right a { color: #3366cc; text-decoration: none; }

        /* ========== Tab 切换 ========== */
        .mode-tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 12px;
            border-bottom: 2px solid #e9ecef;
        }

        .mode-tab {
            padding: 10px 24px;
            background: transparent;
            border: none;
            border-bottom: 3px solid transparent;
            font-size: 13px;
            font-weight: 600;
            color: #6c757d;
            cursor: pointer;
            transition: all 0.2s;
        }

        .mode-tab.active {
            color: #3366cc;
            border-bottom-color: #3366cc;
        }

        .mode-tab:hover { color: #3366cc; }

        .mode-content { display: none; flex: 1; min-height: 0; }
        .mode-content.active { display: flex; flex-direction: column; }

        /* ========== 对话模式布局 ========== */
        .chat-mode-layout {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 16px;
            flex: 1;
            min-height: 0;
        }

        .left-panel {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 0;
        }

        /* ========== Plan 模式布局 ========== */
        .plan-mode-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 16px;
            flex: 1;
            min-height: 0;
        }

        .plan-left {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 0;
        }

        .plan-right {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 0;
        }

        /* ========== 通用面板样式 ========== */
        .panel {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .panel-header {
            padding: 8px 14px;
            border-bottom: 1px solid #e9ecef;
            font-weight: 600;
            font-size: 12px;
            color: #495057;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-header::before {
            content: '';
            width: 3px;
            height: 12px;
            background: #3366cc;
            border-radius: 2px;
        }

        .panel-body {
            flex: 1;
            padding: 12px;
            overflow-y: auto;
        }

        /* ========== 聊天面板 ========== */
        .chat-panel { flex: 1; }

        .chat-container {
            flex: 1;
            padding: 12px;
            overflow-y: auto;
            background: #fafbfc;
        }

        .chat-message {
            margin-bottom: 10px;
            padding: 10px 14px;
            border-radius: 8px;
            max-width: 85%;
            font-size: 13px;
            line-height: 1.5;
        }

        .message-user {
            background: #3366cc;
            color: white;
            margin-left: auto;
        }

        .message-ai {
            background: white;
            border: 1px solid #e9ecef;
            color: #212529;
        }

        .message-timestamp {
            font-size: 10px;
            opacity: 0.7;
            margin-bottom: 4px;
        }

        .chat-input-area {
            padding: 10px 14px;
            border-top: 1px solid #e9ecef;
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .chat-input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 6px;
            font-size: 13px;
            min-height: 40px;
            max-height: 100px;
            resize: none;
            font-family: inherit;
        }

        .chat-input:focus {
            outline: none;
            border-color: #3366cc;
        }

        .typing-indicator {
            display: none;
            padding: 6px 14px;
            color: #6c757d;
            font-size: 11px;
            align-items: center;
            gap: 6px;
        }

        .loading {
            width: 12px;
            height: 12px;
            border: 2px solid #e9ecef;
            border-top: 2px solid #3366cc;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ========== 输入面板 ========== */
        .input-panel { padding: 12px; }

        .input-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            align-items: end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .form-group label {
            font-size: 10px;
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
        }

        .form-group input, .form-group textarea {
            padding: 6px 10px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 12px;
            font-family: 'JetBrains Mono', monospace;
        }

        .form-group input:focus, .form-group textarea:focus {
            outline: none;
            border-color: #3366cc;
        }

        .form-group textarea {
            min-height: 50px;
            resize: vertical;
        }

        .radio-group {
            display: flex;
            gap: 10px;
        }

        .radio-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            cursor: pointer;
        }

        .btn-group {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .btn {
            padding: 6px 14px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
            transition: all 0.2s;
        }

        .btn-primary { background: #3366cc; color: white; }
        .btn-primary:hover { background: #2851a3; }
        .btn-secondary { background: #e9ecef; color: #495057; }
        .btn-secondary:hover { background: #dee2e6; }
        .btn-success { background: #28a745; color: white; }
        .btn-success:hover { background: #218838; }

        /* ========== 右侧面板 ========== */
        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 0;
        }

        .graph-panel { flex: 1; min-height: 200px; }

        #cy {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: #fafbfc;
        }

        #cy-placeholder {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 11px;
            pointer-events: none;
        }

        /* Session 面板 */
        .session-panel { padding: 10px 12px; font-size: 11px; }

        .status-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 5px 10px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 4px;
            margin-bottom: 8px;
            font-size: 10px;
        }

        .status-bar.info { background: #e7f3ff; border-color: #b6d4fe; }
        .status-bar.success { background: #d1e7dd; border-color: #a3cfbb; }
        .status-bar.error { background: #f8d7da; border-color: #f1aeb5; }

        .status-icon { font-size: 8px; color: #6c757d; }
        .status-bar.info .status-icon { color: #0d6efd; }
        .status-bar.success .status-icon { color: #198754; }
        .status-bar.error .status-icon { color: #dc3545; }

        .session-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 10px;
        }

        .session-item {
            display: flex;
            justify-content: space-between;
            padding: 2px 0;
        }

        .session-item label { color: #6c757d; font-size: 10px; }
        .session-item span { font-weight: 500; font-family: 'JetBrains Mono', monospace; font-size: 10px; }

        .session-actions {
            display: flex;
            gap: 6px;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid #e9ecef;
        }

        .session-actions .btn { flex: 1; padding: 4px 6px; font-size: 10px; }

        /* ========== Plan 模式特有样式 ========== */
        .pipeline-builder {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .pipeline-visual {
            flex: 1;
            background: #fafbfc;
            border: 1px dashed #dee2e6;
            border-radius: 4px;
            padding: 12px;
            min-height: 200px;
            display: flex;
            align-items: flex-start;
            align-content: flex-start;
            gap: 8px;
            flex-wrap: wrap;
            overflow-y: auto;
        }

        .pipeline-node {
            padding: 8px 12px;
            background: #e7f3ff;
            border: 1px solid #3366cc;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
            color: #3366cc;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: grab;
            user-select: none;
            transition: all 0.2s ease;
        }

        .pipeline-node:hover {
            box-shadow: 0 2px 8px rgba(51, 102, 204, 0.25);
            transform: translateY(-1px);
        }

        .pipeline-node:active {
            cursor: grabbing;
        }

        .pipeline-node .drag-handle {
            color: #adb5bd;
            font-size: 12px;
            cursor: grab;
            margin-right: 2px;
        }

        .pipeline-node .drag-handle:hover {
            color: #3366cc;
        }

        .pipeline-node .node-index {
            background: #3366cc;
            color: white;
            font-size: 9px;
            font-weight: 600;
            min-width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pipeline-node .node-name {
            flex: 1;
        }

        .pipeline-node .remove-btn {
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            padding: 0 2px;
        }

        .pipeline-node .remove-btn:hover { color: #dc3545; }

        .pipeline-node .node-arrow {
            color: #adb5bd;
            font-size: 14px;
            margin-left: 4px;
            flex-shrink: 0;
        }

        .pipeline-arrow {
            color: #adb5bd;
            font-size: 16px;
            flex-shrink: 0;
        }

        .pipeline-empty {
            color: #adb5bd;
            font-size: 12px;
            text-align: center;
            width: 100%;
            padding: 40px 20px;
        }

        /* Sortable.js 拖拽样式 */
        .pipeline-node.sortable-ghost {
            opacity: 0.4;
            background: #cce0ff;
        }

        .pipeline-node.sortable-chosen {
            box-shadow: 0 4px 12px rgba(51, 102, 204, 0.35);
            transform: scale(1.02);
        }

        .pipeline-node.sortable-drag {
            opacity: 1;
            background: #d4e5ff;
        }

        .pipeline-hint {
            width: 100%;
            text-align: center;
            font-size: 10px;
            color: #adb5bd;
            padding-top: 8px;
            border-top: 1px dashed #e9ecef;
            margin-top: auto;
        }

        /* Plan 对话样式增强 */
        .reasoning-box {
            background: #f0f4f8;
            border-left: 3px solid #6c757d;
            padding: 8px 10px;
            margin-bottom: 8px;
            font-size: 11px;
            color: #495057;
            border-radius: 0 4px 4px 0;
            white-space: pre-wrap;
        }

        .tools-selected {
            margin-top: 8px;
            padding: 6px 10px;
            background: #e7f3ff;
            border-radius: 4px;
            font-size: 10px;
            color: #3366cc;
            font-family: monospace;
        }

        .thinking {
            opacity: 0.7;
        }

        .thinking-dots {
            color: #6c757d;
            font-style: italic;
        }

        .thinking-dots span {
            animation: blink 1.4s infinite both;
        }

        .thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
        .thinking-dots span:nth-child(3) { animation-delay: 0.4s; }

        @keyframes blink {
            0%, 80%, 100% { opacity: 0; }
            40% { opacity: 1; }
        }

        /* 工具列表 */
        .tool-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 120px;
            overflow-y: auto;
        }

        .tool-chip {
            padding: 4px 10px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            font-size: 10px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .tool-chip:hover {
            background: #e7f3ff;
            border-color: #3366cc;
            color: #3366cc;
        }

        .tool-chip.added {
            background: #d4edda;
            border-color: #28a745;
            color: #155724;
        }

        /* YAML 预览弹窗 */
        .yaml-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .yaml-modal.open { display: flex; }

        .yaml-content {
            background: white;
            border-radius: 8px;
            width: 500px;
            max-height: 80vh;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .yaml-header {
            padding: 14px 18px;
            background: #3366cc;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .yaml-header h3 { font-size: 14px; margin: 0; }

        .yaml-body {
            padding: 16px;
            max-height: 60vh;
            overflow-y: auto;
        }

        .yaml-code {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 16px;
            border-radius: 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            line-height: 1.5;
            white-space: pre-wrap;
            overflow-x: auto;
        }

        .yaml-footer {
            padding: 12px 18px;
            border-top: 1px solid #e9ecef;
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }

        /* Knowledge Presets */
        .knowledge-presets select {
            width: 100%;
            padding: 6px 10px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 11px;
            background: white;
            cursor: pointer;
        }

        .knowledge-presets select:focus {
            outline: none;
            border-color: #3366cc;
        }

        /* Template Detail Modal */
        .template-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .template-modal.open { display: flex; }

        .template-detail-content {
            background: white;
            border-radius: 8px;
            width: 550px;
            max-height: 80vh;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .template-detail-header {
            padding: 14px 18px;
            background: #28a745;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .template-detail-body {
            padding: 16px;
            max-height: 60vh;
            overflow-y: auto;
        }

        .template-section {
            margin-bottom: 16px;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 6px;
            border-left: 3px solid #3366cc;
        }

        .template-section h4 {
            margin: 0 0 8px 0;
            font-size: 13px;
            color: #3366cc;
        }

        .template-fields {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .field-tag {
            padding: 3px 8px;
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            font-size: 10px;
            font-family: monospace;
        }

        .field-tag.required {
            border-color: #dc3545;
            color: #dc3545;
        }

        .field-tag.optional {
            border-color: #6c757d;
            color: #6c757d;
        }

        /* 自定义模板样式 */
        .template-option.custom {
            border-color: #6f42c1;
            background: #f8f4ff;
        }

        .template-option.custom .template-name {
            color: #6f42c1;
        }

        .saved-template-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 8px;
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 4px;
            margin-bottom: 4px;
            font-size: 11px;
        }

        .saved-template-item:hover {
            background: #f8f9fa;
        }

        .saved-template-item .name {
            font-weight: 500;
        }

        .saved-template-item .actions button {
            background: none;
            border: none;
            cursor: pointer;
            padding: 2px 4px;
            font-size: 11px;
        }

        .saved-template-item .actions button:hover {
            color: #3366cc;
        }

        /* 自定义模板字段卡片样式 */
        .template-fields-section {
            margin-bottom: 16px;
        }

        .template-fields-section .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .template-fields-section .section-title {
            font-size: 12px;
            font-weight: 600;
            color: #495057;
        }

        .template-fields-section .add-field-btn {
            padding: 4px 10px;
            font-size: 10px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .template-fields-section .add-field-btn:hover {
            background: #218838;
        }

        .field-cards-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 200px;
            overflow-y: auto;
        }

        .field-card {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
