    <script>
        // ==================== 基础路径配置（支持子路径部署） ====================
        // 自动检测基础路径，移除末尾斜杠
        const BASE_URL = window.location.pathname.replace(/\/$/, '') || '';
        console.log('[Config] BASE_URL:', BASE_URL);
        
        // ==================== 全局状态 ====================
        let currentUser = null;
        let currentMode = 'chat';
        let currentPrecursor = '[M-H]-';
        let cy = null;
        let isAnalyzing = false;
        let isSendingMessage = false;
        
        // Plan 模式状态
        let currentPipeline = [];
        let pipelineRepo = [];
        let toRunQueue = [];
        
        // 文件上传状态
        let uploadedFiles = [];
        let totalSpectraCount = 0;

        // ==================== 初始化 ====================
        document.addEventListener('DOMContentLoaded', function() {
            // 初始化文件拖拽
            initFileDragDrop();
            
            // 用户需要手动登录（需要密码验证）
            // 如果有保存的用户名，预填充
            const savedUser = localStorage.getItem('msagent_user');
            if (savedUser) {
                document.getElementById('username-input').value = savedUser;
            }

            // 监听输入
            document.querySelectorAll('input[name="precursor"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    currentPrecursor = this.value;
                    updatePrecursor();
                });
            });
            
            document.getElementById('ms2-data').addEventListener('input', updateMS2);
            document.getElementById('precursor-mz').addEventListener('input', updatePrecursorMZ);
            document.getElementById('smiles-input').addEventListener('input', updateSMILES);

            // Output template 选择
            document.querySelectorAll('.template-option').forEach(opt => {
                opt.addEventListener('click', function() {
                    document.querySelectorAll('.template-option').forEach(o => o.classList.remove('selected'));
                    this.classList.add('selected');
                    this.querySelector('input').checked = true;
                });
            });

            refreshState();
            setInterval(refreshState, 30000);
            initExecutionGraph();

            setTimeout(() => {
                if (cy) { cy.resize(); applyZigzagLayout(); }
            }, 300);

            window.addEventListener('resize', () => {
                if (cy) { cy.resize(); applyZigzagLayout(); }
            });
        });

        // ==================== 文件上传处理 ====================
        let dragDropInitialized = false;
        
        // 命名函数用于事件监听（可以安全地重复绑定）
        function onDragEnterOver(e) {
            document.getElementById('upload-zone').classList.add('dragover');
        }
        
        function onDragLeaveDrop(e) {
            document.getElementById('upload-zone').classList.remove('dragover');
        }
        
        function initFileDragDrop() {
            const uploadZone = document.getElementById('upload-zone');
            if (!uploadZone) return;
            
            // 防止重复初始化（只需要绑定一次）
            if (dragDropInitialized) {
                console.log('[DragDrop] Already initialized, skipping');
                return;
            }
            
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                uploadZone.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });
            
            ['dragenter', 'dragover'].forEach(eventName => {
                uploadZone.addEventListener(eventName, onDragEnterOver, false);
            });
            
            ['dragleave', 'drop'].forEach(eventName => {
                uploadZone.addEventListener(eventName, onDragLeaveDrop, false);
            });
            
            uploadZone.addEventListener('drop', handleDrop, false);
            
            dragDropInitialized = true;
            console.log('[DragDrop] Initialized successfully');
        }

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            console.log('[DragDrop] Files dropped:', files.length);
            handleFiles(files);
        }

        function handleFileSelect(e) {
            const files = e.target.files;
            handleFiles(files);
        }

        async function handleFiles(files) {
            console.log('[HandleFiles] Called with', files.length, 'files');
            console.log('[HandleFiles] currentUser:', currentUser);
            
            if (!currentUser) {
                alert('Please login first');
                return;
            }
            
            const validFiles = Array.from(files).filter(f => 
                f.name.endsWith('.mgf') || 
                f.name.toLowerCase().endsWith('.mzml') || 
                f.name.toLowerCase().endsWith('.mzxml')
            );
            console.log('[HandleFiles] Valid files:', validFiles.map(f => f.name));
            
            if (validFiles.length === 0) {
                alert('Please upload .mgf, .mzML, or .mzXML files');
                return;
            }
            
            // 显示进度
            document.getElementById('upload-progress').style.display = 'flex';
            document.getElementById('progress-text').textContent = 'Uploading...';
            
            for (let i = 0; i < validFiles.length; i++) {
                const file = validFiles[i];
                console.log(`[HandleFiles] Processing file ${i + 1}/${validFiles.length}: ${file.name}`);
                
                const progress = ((i + 1) / validFiles.length) * 100;
                document.getElementById('progress-fill').style.width = progress + '%';
                document.getElementById('progress-text').textContent = `Processing ${file.name}...`;
                
                try {
                    await uploadFile(file);
                    console.log(`[HandleFiles] Completed: ${file.name}`);
                } catch (e) {
                    console.error(`[HandleFiles] Error uploading ${file.name}:`, e);
                }
            }
            
            document.getElementById('upload-progress').style.display = 'none';
            updateStatus(`${validFiles.length} file(s) uploaded successfully`, 'success');
            console.log('[HandleFiles] All uploads complete');
        }

        async function uploadFile(file) {
            console.log('[Upload] Starting upload for:', file.name);
            
            const formData = new FormData();
            formData.append('file', file);
            
            // 获取用户选择的 Meta 信息
            const msParams = getMSParams();
            console.log('[Upload] MS Params:', msParams);
            
            // 添加 Meta 信息（处理 null 值）
            formData.append('adduct', msParams.adduct || '');
            formData.append('collision_energy', msParams.collision_energy !== null ? msParams.collision_energy : '');
            formData.append('ce_type', msParams.ce_type || 'NCE');
            formData.append('instrument', msParams.instrument || 'QTOF');
            
            console.log('[Upload] Sending request to /api/upload/file...');
            
            try {
                const response = await fetch(BASE_URL + '/api/upload/file', {
                    method: 'POST',
                    body: formData
                });
                console.log('[Upload] Response status:', response.status);
                
                const data = await response.json();
                
                if (data.status === 'success') {
                    uploadedFiles.push({
                        name: file.name,
                        size: file.size,
                        spectra_count: data.spectra_count || 0,
                        path: data.path
                    });
                    // 使用后端返回的总数（更准确）
                    totalSpectraCount = data.total_spectra || totalSpectraCount + (data.spectra_count || 0);
                    updateFileStats();
                    console.log(`[Upload] ${file.name}: ${data.spectra_count} spectra parsed, total: ${data.total_spectra}`);
                } else {
                    console.error('Upload failed:', data.message);
                    alert(`Upload failed: ${data.message}`);
                }
            } catch (e) {
                console.error('Upload error:', e);
                alert(`Upload error: ${e.message}`);
            }
        }

        function updateFileStats() {
            document.getElementById('stat-files').textContent = uploadedFiles.length;
            document.getElementById('stat-spectra').textContent = totalSpectraCount;
            
            const fileList = document.getElementById('file-list');
            if (uploadedFiles.length === 0) {
                fileList.innerHTML = '<span style="color: #adb5bd; font-size: 10px;">No files</span>';
                fileList.title = 'No files uploaded';
            } else {
                // 简短显示
                const shortText = uploadedFiles.length <= 2 
                    ? uploadedFiles.map(f => f.name).join(', ')
                    : `${uploadedFiles[0].name} +${uploadedFiles.length - 1} more`;
                
                fileList.innerHTML = `
                    <span style="font-size: 10px;">${shortText}</span>
                    <div style="display: none;" class="file-details">
                        ${uploadedFiles.map((f, i) => `
                            <div class="file-item">
                                <span>[F] ${f.name} (${f.spectra_count})</span>
                                <span class="remove" onclick="event.stopPropagation(); removeFile(${i})">×</span>
                            </div>
                        `).join('')}
                    </div>
                `;
                fileList.title = uploadedFiles.map(f => `${f.name} (${f.spectra_count} spectra)`).join('\n');
            }
        }

        function removeFile(index) {
            totalSpectraCount -= uploadedFiles[index].spectra_count || 0;
            uploadedFiles.splice(index, 1);
            updateFileStats();
        }

        async function clearUploadedFiles() {
            if (uploadedFiles.length === 0) return;
            if (!confirm('Clear all uploaded files?')) return;
            
            console.log('[Clear] Clearing uploaded files...');
            
            try {
                await fetch(BASE_URL + '/api/upload/clear', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'}
                });
                console.log('[Clear] Server cleared successfully');
            } catch (e) {
                console.error('[Clear] Server clear failed:', e);
            }
            
            uploadedFiles = [];
            totalSpectraCount = 0;
            
            // ⭐ 重置 file-input 元素，确保可以重新选择相同文件
            const fileInput = document.getElementById('file-input');
            if (fileInput) {
                fileInput.value = '';
                console.log('[Clear] File input reset');
            }
            
            updateFileStats();
            updateStatus('Files cleared', 'info');
            console.log('[Clear] Complete. DragDrop initialized:', dragDropInitialized);
        }

        // ==================== 用户登录 ====================
        async function login() {
            const username = document.getElementById('username-input').value.trim();
            const password = document.getElementById('password-input').value;
            
            if (!username) {
                alert('Please enter a username');
                return;
            }
            if (!password) {
                alert('Please enter a password');
                return;
            }
            
            await loginWithCredentials(username, password);
        }

        async function loginWithCredentials(username, password) {
            try {
                const response = await fetch(BASE_URL + '/api/user/login', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ username: username, password: password })
                });
                const data = await response.json();
                
                if (data.status === 'success') {
                    currentUser = username;
                    // 保存用户名用于下次预填充（不保存密码）
                    localStorage.setItem('msagent_user', username);
                    
                    document.getElementById('login-area').style.display = 'none';
