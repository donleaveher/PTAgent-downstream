                        ms_params: msParams,
                        selected_spectra: indices.length > 0 ? indices : null,
                        output_template: selectedNetworkPipeline.output_template || { id: 'O1' },
                        domain_knowledge: {
                            type: selectedNetworkPipeline.knowledge_preset ? 'preset' : 'custom',
                            preset: selectedNetworkPipeline.knowledge_preset || '',
                            content: selectedNetworkPipeline.domain_knowledge || ''
                        }
                    })
                });
                
                const data = await response.json();
                
                if (data.status === 'success') {
                    document.getElementById('network-pipeline-status').textContent = 'Completed';
                    document.getElementById('network-pipeline-status').style.color = '#28a745';
                    updateStatus(`Pipeline completed: ${data.success_count || 0}/${data.total_spectra || 0} spectra`, 'success');
                    
                    // 渲染结果
                    renderNetworkPipelineResults(data);
                    
                    // 同时刷新 Batch 结果（因为可能有输出文件）
                    await refreshBatchResults();
                } else {
                    document.getElementById('network-pipeline-status').textContent = 'Failed';
                    document.getElementById('network-pipeline-status').style.color = '#dc3545';
                    container.innerHTML = `
                        <div class="pipeline-result-item error">
                            <div class="result-header">
                                <span class="spectrum-id">Execution Failed</span>
                                <span class="status-icon">❌</span>
                            </div>
                            <div style="color: #721c24;">${data.message || 'Unknown error'}</div>
                        </div>
                    `;
                    updateStatus(data.message || 'Pipeline execution failed', 'error');
                }
            } catch (e) {
                document.getElementById('network-pipeline-status').textContent = 'Error';
                document.getElementById('network-pipeline-status').style.color = '#dc3545';
                container.innerHTML = `
                    <div class="pipeline-result-item error">
                        <div class="result-header">
                            <span class="spectrum-id">Error</span>
                            <span class="status-icon">❌</span>
                        </div>
                        <div style="color: #721c24;">${e.message}</div>
                    </div>
                `;
                updateStatus('Pipeline execution error: ' + e.message, 'error');
            } finally {
                isExecutingPipeline = false;
                btn.disabled = false;
                btn.textContent = 'Execute';
            }
        }

        function renderNetworkPipelineResults(data) {
            const container = document.getElementById('pipeline-results-container');
            
            // 构建结果 HTML
            let html = `
                <div style="padding: 8px; background: #d4edda; border-radius: 4px; margin-bottom: 8px; font-size: 10px; color: #155724;">
                    <strong>✓ Pipeline Completed</strong><br>
                    Processed: ${data.success_count || 0}/${data.total_spectra || 0} spectra | 
                    Time: ${data.elapsed_time || 0}s
                    ${data.download_url ? `| <a href="${BASE_URL}${data.download_url}" target="_blank" style="color: #155724;">Download Report</a>` : ''}
                </div>
            `;
            
            // 如果有详细结果
            if (data.results && data.results.length > 0) {
                data.results.slice(0, 20).forEach((r, i) => {
                    const statusClass = r.success ? 'success' : 'error';
                    const statusIcon = r.success ? '✓' : '✗';
                    
                    html += `
                        <div class="pipeline-result-item ${statusClass}">
                            <div class="result-header">
                                <span class="spectrum-id">Spectrum #${i + 1}</span>
                                <span class="status-icon">${statusIcon}</span>
                            </div>
                            <div class="result-fields">
                                <span class="field-name">Status:</span>
                                <span class="field-value">${r.success ? 'Success' : 'Failed'}</span>
                                ${r.message ? `<span class="field-name">Message:</span><span class="field-value">${r.message}</span>` : ''}
                            </div>
                        </div>
                    `;
                });
                
                if (data.results.length > 20) {
                    html += `<div class="empty-hint">... and ${data.results.length - 20} more results</div>`;
                }
            } else {
                html += `
                    <div class="pipeline-result-item success">
                        <div class="result-header">
                            <span class="spectrum-id">Execution Summary</span>
                            <span class="status-icon">✓</span>
                        </div>
                        <div class="result-fields">
                            <span class="field-name">Total:</span>
                            <span class="field-value">${data.total_spectra || 0} spectra</span>
                            <span class="field-name">Success:</span>
                            <span class="field-value">${data.success_count || 0}</span>
                            <span class="field-name">Failed:</span>
                            <span class="field-value">${data.failed_count || 0}</span>
                        </div>
                    </div>
                `;
            }
            
            container.innerHTML = html;
        }

        // 初始化时也加载 Pipeline 列表
        function initNetworkPipelines() {
            if (currentUser && pipelineRepo.length === 0) {
                refreshNetworkPipelines();
            } else if (pipelineRepo.length > 0) {
                renderNetworkPipelineSelect();
            }
        }
    </script>
</body>
</html>