        function initNetworkCytoscape() {
            networkCy = cytoscape({
                container: document.getElementById('network-cy'),
                style: [
                    { selector: 'node', style: { 'background-color': '#3366cc', 'label': 'data(label)', 'font-size': '8px', 'text-valign': 'bottom', 'text-margin-y': 4, 'width': 20, 'height': 20, 'border-width': 2, 'border-color': '#2851a3' }},
                    { selector: 'node.selected', style: { 'background-color': '#28a745', 'border-color': '#155724', 'border-width': 4, 'width': 26, 'height': 26 }},
                    { selector: 'edge', style: { 'width': 'mapData(similarity, 0.5, 1, 1, 3)', 'line-color': '#adb5bd', 'opacity': 0.6, 'curve-style': 'bezier' }}
                ],
                layout: { name: 'preset' },
                minZoom: 0.3, maxZoom: 3, wheelSensitivity: 0.3,
                // 禁用原生选择行为，完全自定义
                selectionType: 'single',
                autounselectify: true
            });
            
            // 点击节点：根据当前工具模式处理
            networkCy.on('tap', 'node', evt => {
                const nodeId = evt.target.id();
                if (networkToolMode === 'select') {
                    // Select 模式：添加到选中集合
                    if (!selectedNodes.has(nodeId)) {
                        selectedNodes.add(nodeId);
                        evt.target.addClass('selected');
                    }
                } else if (networkToolMode === 'deselect') {
                    // Deselect 模式：从选中集合移除
                    if (selectedNodes.has(nodeId)) {
                        selectedNodes.delete(nodeId);
                        evt.target.removeClass('selected');
                    }
                }
                updateSelectionCount();
            });
            
            // 点击空白处：不做任何操作
            networkCy.on('tap', evt => {
                if (evt.target === networkCy) {
                    // 点击背景时不做任何操作，保持当前选择
                }
            });
        }
        
        // 设置网络工具模式
        function setNetworkTool(mode) {
            networkToolMode = mode;
            // 更新按钮状态
            document.getElementById('tool-select').classList.toggle('active', mode === 'select');
            document.getElementById('tool-deselect').classList.toggle('active', mode === 'deselect');
        }
        
        // 清除所有选择
        function clearNetworkSelection() {
            if (!networkCy) return;
            selectedNodes.clear();
            networkCy.nodes().removeClass('selected');
            updateSelectionCount();
        }
        
        // 全选所有节点
        function selectAllNetworkNodes() {
            if (!networkCy) return;
            networkCy.nodes().forEach(n => {
                selectedNodes.add(n.id());
                n.addClass('selected');
            });
            updateSelectionCount();
        }
        
        // 反选
        function invertNetworkSelection() {
            if (!networkCy) return;
            const allNodeIds = new Set(networkCy.nodes().map(n => n.id()));
            const newSelection = new Set();
            
            allNodeIds.forEach(id => {
                if (!selectedNodes.has(id)) {
                    newSelection.add(id);
                    networkCy.getElementById(id).addClass('selected');
                } else {
                    networkCy.getElementById(id).removeClass('selected');
                }
