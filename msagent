        // ==================== Bind Layout 功能 ====================
        function applyBindLayout() {
            if (!networkCy) return;
            
            // 获取选中的节点
            const selectedNodeIds = Array.from(selectedNodes);
            if (selectedNodeIds.length === 0) {
                alert('Please select at least one node as the center');
                return;
            }
            
            // 获取 m/z 容差
            const tolerance = parseFloat(document.getElementById('bind-mz-tolerance').value) || 1.0;
            
            const container = document.getElementById('network-cy');
            const centerX = container.offsetWidth / 2;
            const centerY = container.offsetHeight / 2;
            
            // 获取选中节点的信息
            const centerNodes = selectedNodeIds.map(id => {
                const node = networkCy.getElementById(id);
                return {
                    id: id,
                    mz: node.data('precursor_mz') || 0
                };
            });
            
            // 计算每个节点应该在哪个组
            const allNodes = networkCy.nodes();
            const groupedNodes = new Map(); // key: center node id, value: array of bound nodes
            const unboundNodes = [];
            
            // 初始化每个中心节点的组
            centerNodes.forEach(cn => {
                groupedNodes.set(cn.id, []);
            });
            
            allNodes.forEach(node => {
                const nodeId = node.id();
                const nodeMz = node.data('precursor_mz') || 0;
                
                // 如果是中心节点，跳过
                if (selectedNodes.has(nodeId)) return;
                
                // 查找最近的中心节点
                let closestCenter = null;
                let minDiff = Infinity;
                
                centerNodes.forEach(cn => {
                    const diff = Math.abs(nodeMz - cn.mz);
                    if (diff <= tolerance && diff < minDiff) {
                        minDiff = diff;
                        closestCenter = cn.id;
                    }
                });
                
                if (closestCenter) {
                    groupedNodes.get(closestCenter).push(nodeId);
                } else {
                    unboundNodes.push(nodeId);
                }
            });
            
            // 计算布局位置
            const positions = {};
            
            // 布局参数
            const groupRadius = 80; // 每个组的半径
            const groupSpacing = 200; // 组之间的间距
            const unboundAreaX = centerX + 250; // 未绑定节点区域的 X 位置
            
            // 计算中心节点组的位置
            const numGroups = centerNodes.length;
            const groupAngleStep = (2 * Math.PI) / Math.max(numGroups, 1);
            const groupCenterRadius = numGroups > 1 ? 120 : 0;
            
            centerNodes.forEach((cn, groupIndex) => {
                // 中心节点位置
                const groupCenterX = centerX - 100 + groupCenterRadius * Math.cos(groupIndex * groupAngleStep);
                const groupCenterY = centerY + groupCenterRadius * Math.sin(groupIndex * groupAngleStep);
                
                positions[cn.id] = { x: groupCenterX, y: groupCenterY };
                
                // 围绕中心节点布置绑定的节点
                const boundNodes = groupedNodes.get(cn.id);
                const numBound = boundNodes.length;
                
                if (numBound > 0) {
                    const angleStep = (2 * Math.PI) / numBound;
                    boundNodes.forEach((nodeId, i) => {
                        const angle = i * angleStep - Math.PI / 2;
                        positions[nodeId] = {
                            x: groupCenterX + groupRadius * Math.cos(angle),
                            y: groupCenterY + groupRadius * Math.sin(angle)
                        };
                    });
                }
            });
            
            // 布置未绑定的节点（在右侧区域）
            const numUnbound = unboundNodes.length;
            if (numUnbound > 0) {
                const cols = Math.ceil(Math.sqrt(numUnbound));
                const spacing = 40;
                unboundNodes.forEach((nodeId, i) => {
                    const row = Math.floor(i / cols);
                    const col = i % cols;
                    positions[nodeId] = {
                        x: unboundAreaX + col * spacing,
                        y: 50 + row * spacing
                    };
                });
            }
            
            // 应用布局
            networkCy.nodes().forEach(node => {
                const pos = positions[node.id()];
                if (pos) {
                    node.animate({
                        position: pos,
                        duration: 500,
                        easing: 'ease-out-cubic'
                    });
                }
            });
            
            // 统计信息
            let boundCount = 0;
            groupedNodes.forEach(nodes => boundCount += nodes.length);
            updateStatus(`Bind: ${boundCount} nodes grouped around ${centerNodes.length} center(s), ${unboundNodes.length} unbound`, 'success');
        }
        
