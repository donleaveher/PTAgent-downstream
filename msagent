            // 辅助函数：将字段转换为标准格式
            const normalizeField = (f, fieldType) => {
                if (typeof f === 'string') {
                    return { name: f, type: fieldType, behavior: 'selection', dataType: 'str', desc: '' };
                }
                return {
                    name: f.name || 'unknown',
                    type: fieldType,
                    behavior: f.behavior || 'selection',
                    dataType: f.type || 'str',
                    desc: f.description || ''
                };
            };
            
            // 如果不在预设中，检查自定义模板
            if (!template) {
                const customTemplate = customTemplates.find(t => t.id === templateId);
                if (customTemplate) {
                    template = {
                        name: customTemplate.name,
                        description: customTemplate.description || 'Custom template',
                        fields: [
                            ...(customTemplate.required_fields || []).map(f => normalizeField(f, 'required')),
                            ...(customTemplate.optional_fields || []).map(f => normalizeField(f, 'optional'))
                        ]
                    };
                    isCustom = true;
                }
            }
            
            if (!template) {
                template = outputTemplates['O1']; // 默认
            }
            
            const container = document.getElementById('template-detail-body');
            const requiredFields = template.fields.filter(f => f.type === 'required');
            const optionalFields = template.fields.filter(f => f.type === 'optional');
            
            // 渲染字段卡片（带 behavior 标签）
            const renderFieldTag = (f) => {
                const behaviorClass = f.behavior === 'sort' ? 'behavior-sort' : 'behavior-selection';
                const behaviorLabel = f.behavior === 'sort' ? '[sort]' : '[select]';
                return `
                    <div class="field-tag ${f.type}" title="${f.desc || f.dataType || ''}">
