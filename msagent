        function applyZigzagLayout() {
            if (!cy) return;
            const nodes = cy.nodes();
            if (nodes.length === 0) return;

            const container = document.getElementById('cy');
            const width = container.offsetWidth;
            const height = container.offsetHeight;
            const padding = 15;
            const cols = 2;
            const rows = Math.ceil(nodes.length / cols);
            const colSpacing = (width - 2 * padding) / (cols + 1);
            const rowSpacing = rows > 1 ? (height - 2 * padding) / (rows + 1) : height / 2;

            const sortedNodes = nodes.sort((a, b) => 
                parseInt(a.id().replace('node_', '')) - parseInt(b.id().replace('node_', ''))
            );

            sortedNodes.forEach((node, index) => {
                const row = Math.floor(index / cols);
                const col = index % cols;
                node.position({ x: padding + colSpacing * (col + 1), y: padding + rowSpacing * (row + 1) });
            });
        }

        function addExecutionEdges() {
            if (!cy) return;
            const nodes = cy.nodes();
            if (nodes.length < 2) return;

            const sortedNodes = nodes.sort((a, b) => 
                parseInt(a.id().replace('node_', '')) - parseInt(b.id().replace('node_', ''))
            );

            for (let i = 0; i < sortedNodes.length - 1; i++) {
                const edgeId = `${sortedNodes[i].id()}-${sortedNodes[i + 1].id()}`;
                if (cy.getElementById(edgeId).length === 0) {
                    cy.add({ group: 'edges', data: { id: edgeId, source: sortedNodes[i].id(), target: sortedNodes[i + 1].id() } });
                }
            }
        }

        function addOrUpdateNode(nodeData) {
            if (!cy) return;
            document.getElementById('cy-placeholder').style.display = 'none';
            
            let color = '#e9ecef', borderColor = '#adb5bd';
            if (nodeData.status === 'running') { color = '#cce5ff'; borderColor = '#3366cc'; }
            else if (nodeData.status === 'success') { color = '#d4edda'; borderColor = '#28a745'; }
            else if (nodeData.status === 'failed') { color = '#f8d7da'; borderColor = '#dc3545'; }

            const existing = cy.getElementById(nodeData.id);
            if (existing.length > 0) {
                existing.data({ label: nodeData.display_name, color, borderColor, nodeData });
            } else {
                cy.add({ group: 'nodes', data: { id: nodeData.id, label: nodeData.display_name, color, borderColor, nodeData } });
            }
        }

