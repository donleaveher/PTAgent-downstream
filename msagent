        function getMSParams() {
            let adduct = document.getElementById('param-adduct').value;
            if (adduct === 'custom') {
                adduct = document.getElementById('param-adduct-custom').value || '[M-H]-';
            }
            
            const ceValue = document.getElementById('param-ce').value;
            const ceType = document.getElementById('param-ce-type').value;
            
            return {
                adduct: adduct,
                collision_energy: ceValue ? parseFloat(ceValue) : null,
                ce_type: ceType,
                instrument: document.getElementById('param-instrument').value
            };
        }

        function addExecutionReport(report) {
            executionReports.unshift(report);
            renderExecutionReports();
