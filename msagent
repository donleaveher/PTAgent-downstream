        function addMessage(sender, message, type) {
            if (type === 'system') { updateStatus(message, 'info'); return; }
            const container = document.getElementById('chat-container');
            const div = document.createElement('div');
            div.className = `chat-message message-${type}`;
            div.innerHTML = `<div class="message-timestamp">[${new Date().toLocaleTimeString()}] ${sender}</div><div>${message.replace(/\n/g, '<br>')}</div>`;
            container.appendChild(div);
            scrollToBottom();
        }

        function streamResponse(sender, response) {
            if (!response) return;
            if (sender === 'System') { updateStatus(response.split('\n')[0].substring(0, 50), 'success'); return; }
            
            const container = document.getElementById('chat-container');
            const div = document.createElement('div');
            div.className = `chat-message message-ai`;
            div.innerHTML = `<div class="message-timestamp">[${new Date().toLocaleTimeString()}] ${sender}</div><div class="streaming-content"></div>`;
            container.appendChild(div);
            scrollToBottom();

            const content = div.querySelector('.streaming-content');
            const formatted = String(response).replace(/\n/g, '<br>');
            let delay = formatted.length > 1000 ? 1 : formatted.length > 500 ? 3 : 5;
            let i = 0, text = '';

            function type() {
                if (i < formatted.length) { text += formatted[i++]; content.innerHTML = text; scrollToBottom(); setTimeout(type, delay); }
            }
            type();
        }

        function updateStatus(message, type = 'info') {
            const statusBar = document.getElementById('status-bar');
