            pipelineSortable = new Sortable(nodesContainer, {
                animation: 200,
                easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                draggable: '.pipeline-node',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
                
                onEnd: function(evt) {
                    const oldIndex = evt.oldIndex;
                    const newIndex = evt.newIndex;
                    
                    if (oldIndex !== newIndex) {
                        // 移动数组元素
                        const [movedItem] = currentPipeline.splice(oldIndex, 1);
                        currentPipeline.splice(newIndex, 0, movedItem);
                        
                        // 重新渲染以更新编号和箭头
                        renderPipeline();
                        renderToolsList(allTools);
                        
                        updateStatus(`Moved "${movedItem.display_name || movedItem.name}" to position ${newIndex + 1}`, 'info');
                    }
                }
            });
