        // ==================== Queue 执行功能 ====================
        let executionReports = [];
        let isExecuting = false;

        async function executeQueue() {
            if (toRunQueue.length === 0) { 
                alert('Queue is empty. Add pipelines first.'); 
                return; 
            }
            
            // 检查是否有上传的文件
            const uploadedFiles = await getUploadedFilesList();
            if (uploadedFiles.length === 0) {
                alert('No input files. Please upload MGF/mzML files first.');
                return;
            }
            
            if (isExecuting) {
                alert('Execution already in progress');
                return;
            }
            
            isExecuting = true;
            document.getElementById('btn-execute').disabled = true;
            document.getElementById('btn-execute').textContent = 'Running...';
            
            // 获取 MS 参数
            const msParams = getMSParams();
            
            // 遍历队列执行
            for (let i = 0; i < toRunQueue.length; i++) {
                const queueItem = toRunQueue[i];
                queueItem.status = 'running';
                renderToRunQueue();
                
                try {
                    // ⭐ 获取 output_template 的完整配置
                    const templateId = queueItem.output_template || 'O1';
                    let outputTemplateConfig = { id: templateId };
                    
                    // 如果是自定义模板（C开头），从 customTemplates 获取完整配置
                    if (templateId.startsWith('C')) {
                        const customTpl = customTemplates.find(t => t.id === templateId);
                        if (customTpl) {
                            outputTemplateConfig = customTpl;
                        }
                    }
                    
                    const response = await fetch(BASE_URL + '/api/pipeline/execute', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            pipeline_id: queueItem.pipeline_id,
                            pipeline_name: queueItem.name,
                            tools: queueItem.tools.map(t => t.name || t),
                            ms_params: msParams,
                            output_template: outputTemplateConfig,  // ⭐ 传递完整模板配置
                            domain_knowledge: {
                                type: queueItem.knowledge_preset ? 'preset' : 'custom',
                                preset: queueItem.knowledge_preset || '',
                                content: queueItem.domain_knowledge || ''
                            }
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (data.status === 'success') {
                        queueItem.status = 'done';
                        // 添加到报告列表
                        addExecutionReport({
                            id: data.report_id || Date.now(),
                            name: queueItem.name,
                            status: 'success',
                            spectra_processed: data.success_count || data.total_spectra || 0,
                            total_spectra: data.total_spectra || 0,
                            failed_count: data.failed_count || 0,
                            elapsed_time: data.elapsed_time || 0,
                            created_at: new Date().toISOString(),
                            download_url: data.download_url
                        });
                        console.log('[Execute] Report added:', data);
                    } else {
                        queueItem.status = 'error';
                        addExecutionReport({
                            id: Date.now(),
                            name: queueItem.name,
                            status: 'error',
                            message: data.message || 'Execution failed',
                            created_at: new Date().toISOString()
                        });
                    }
                } catch (e) {
                    queueItem.status = 'error';
                    addExecutionReport({
                        id: Date.now(),
                        name: queueItem.name,
                        status: 'error',
                        message: e.message,
                        created_at: new Date().toISOString()
                    });
                }
                
                renderToRunQueue();
            }
            
            isExecuting = false;
            document.getElementById('btn-execute').disabled = false;
            document.getElementById('btn-execute').textContent = 'Execute';
            updateStatus('Execution completed', 'success');
        }

        async function getUploadedFilesList() {
