# PTAgent 配置示例（请复制为 `.env` 并根据环境修改）

# 运行环境：dev / staging / prod
PTAGENT_ENV=dev

# 对外 API 版本
PTAGENT_API_VERSION=v1

# ======================
# JWT 配置（示例）
# ======================
# 签名密钥（请在实际环境中使用安全随机值）
PTAGENT_JWT__SECRET_KEY=change_me_to_a_secure_random_string
# 签名算法
PTAGENT_JWT__ALGORITHM=HS256
# JWT 发行方（需与 token 中 iss 一致）
PTAGENT_JWT__ISSUER=ProtAgent
# 时间误差容忍（秒）
PTAGENT_JWT__LEEWAY_SECONDS=60

# ======================
# MCP 配置（示例）
# ======================
# MCP 服务访问地址（按实际部署填写，例如：http://localhost:9000）
PTAGENT_MCP__ENDPOINT=http://localhost:9000
# MCP 运行模式（与 header 中 mcpMode 对应）
PTAGENT_MCP__MODE=default
# MCP 版本（与 header 中 mcpVersion 对应）
PTAGENT_MCP__VERSION=1.0.0
# 后端启动时是否自动拉起 MCP Broker 子进程
# PTAGENT_MCP__AUTO_START_SUBPROCESS=true
# 子进程 PID 文件（与 ensure_subprocess 配合）
# PTAGENT_MCP__SUBPROCESS_PID_FILE=/tmp/ptagent-mcp-server.pid
# 进程内发现中心注册名
# PTAGENT_MCP__DISCOVERY_SERVICE_NAME=mcp-server

# mcp_tools（代码在 src/mcp_tools）：并行启动 Tool Provider（./scripts/run-mcp-tool-providers.sh）
# PTAGENT_MCP__ENDPOINT 必填且与 Broker 一致；Provider 不占新端口，仅连 WebSocket
# MCP_TOOLS_PROVIDERS=basic.peptide
# MCP_TOOL_PROVIDER_MODULE=pkg.mcp.provider

# ======================
# LLM Provider 配置（示例）
# ======================

# OpenAI / 兼容 OpenAI 协议服务
# PTAGENT_OPENAI_API_BASE=https://api.openai.com/v1
# PTAGENT_OPENAI_API_KEY=your_openai_api_key_here

# Qwen（阿里百炼，兼容 OpenAI 协议）
# PTAGENT_QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# PTAGENT_QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek（兼容 OpenAI 协议）
# PTAGENT_DEEPSEEK_API_BASE=https://api.deepseek.com
# PTAGENT_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# HKUST GPT 代理（兼容 OpenAI 协议）
# PTAGENT_HKUST_GPT_API_BASE=https://gpt-api.hkust-gz.edu.cn/v1
# PTAGENT_HKUST_GPT_API_KEY=your_hkust_gpt_api_key_here

# GLM / 智谱
# PTAGENT_GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# PTAGENT_GLM_API_KEY=your_glm_api_key_here

