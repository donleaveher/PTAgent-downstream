# PTAgent 配置示例（请复制为 `.env` 并根据环境修改）

# 运行环境：dev / staging / prod
PTAGENT_ENV=dev

# 对外 API 版本
PTAGENT_API_VERSION=v1

# ======================
# 端口表（同机多进程时避免冲突，按实际修改）
# ======================
# | 进程 / 服务              | 默认端口 | 主要环境变量 |
# |-------------------------|----------|----------------|
# | PTAgent-server (uvicorn) | 8000     | PORT |
# | PTAgent-frontend 边缘   | 8080     | PTAGENT_EDGE_PORT |
# | MCP Broker 独立脚本      | 8765     | MCP_BROKER_PORT（见 scripts/run-mcp-broker.sh） |
# | Casanovo / learning HTTP| 9001     | PTAGENT_PORT（本仓 start_all 默认 9001，勿与 8765 复用） |
# Provider（PTAgent-mcp 等）不占独立业务端口，仅经 PTAGENT_MCP_SETTINGS__ENDPOINT 连 Broker WebSocket。

# ======================
# JWT 配置（示例）
# ======================
# 签名密钥（请在实际环境中使用安全随机值）
PTAGENT_JWT__SECRET_KEY=change_me_to_a_secure_random_string
# 签名算法
PTAGENT_JWT__ALGORITHM=HS256
# JWT 发行方（需与 token 中 iss 一致）
PTAGENT_JWT__ISSUER=ProtAgent
# 时间误差容忍（秒）
PTAGENT_JWT__LEEWAY_SECONDS=60

# ======================
# MCP 配置（示例）
# ======================
# MCP（与 Broker 监听一致，例如子进程在 8765: http://127.0.0.1:8765/mcp）
PTAGENT_MCP_SETTINGS__ENDPOINT=http://127.0.0.1:8765/mcp
# MCP 运行模式（与 header 中 mcpMode 对应）
PTAGENT_MCP_SETTINGS__MODE=default
# MCP 版本（与 header 中 mcpVersion 对应）
PTAGENT_MCP_SETTINGS__VERSION=1.0.0
# 后端启动时是否自动拉起 MCP Broker 子进程（与 endpoint 中端口一致；与 PTAgent-mcp 同时跑时须为 true 或手动手起 Broker）
PTAGENT_MCP_SETTINGS__AUTO_START_SUBPROCESS=true
# 子进程 PID 文件（与 ensure_subprocess 配合）
# PTAGENT_MCP_SETTINGS__SUBPROCESS_PID_FILE=/tmp/ptagent-mcp-server.pid
# 进程内发现中心注册名
# PTAGENT_MCP_SETTINGS__DISCOVERY_SERVICE_NAME=mcp-server

# Admin 向导「物种检索」调用的 MCP 工具名（默认 search_organism_taxonomy，参数 query/limit）
# PTAGENT_UNIPROT_TAXONOMY_MCP_TOOL=search_organism_taxonomy

# 下游全量蛋白基础注释（师兄提供的 UniProt MCP 工具）
# PTAGENT_ANNOTATION__UNIPROT_MCP_TOOL=get_protein_annotations
# PTAGENT_ANNOTATION__ACCESSIONS_ARGUMENT=accessions
# PTAGENT_ANNOTATION__BATCH_SIZE=100
# PTAGENT_ANNOTATION__SOURCE_VERSION=MCP-current

# （可选）外部 MCP Tool Provider 进程：与主仓无 Python 依赖，自行部署后连同一 Broker
# ./scripts/run-mcp-tool-providers.sh 仅为便捷封装，需 PTAGENT_MCP_ROOT 指向该工具仓根目录
# PTAGENT_MCP_ROOT=/path/to/your-mcp-tools-repo
# PTAGENT_MCP_SETTINGS__ENDPOINT 必填且与 Broker 一致；Provider 不占新端口，仅连 WebSocket
# PTAGENT_MCP_BROKER_RECONNECT_INTERVAL=10
# MCP_TOOLS_PROVIDERS=...
# MCP_TOOL_PROVIDER_MODULE=...  # 由外部工具仓文档约定

# ======================
# LLM Provider 配置（示例）
# ======================

# OpenAI / 兼容 OpenAI 协议服务
# PTAGENT_OPENAI_API_BASE=https://api.openai.com/v1
# PTAGENT_OPENAI_API_KEY=your_openai_api_key_here

# Qwen（阿里百炼，兼容 OpenAI 协议）
# PTAGENT_QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# PTAGENT_QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek（兼容 OpenAI 协议）
# PTAGENT_DEEPSEEK_API_BASE=https://api.deepseek.com
# PTAGENT_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# HKUST GPT 代理（兼容 OpenAI 协议）
# PTAGENT_HKUST_GPT_API_BASE=https://gpt-api.hkust-gz.edu.cn/v1
# PTAGENT_HKUST_GPT_API_KEY=your_hkust_gpt_api_key_here

# GLM / 智谱
# PTAGENT_GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# PTAGENT_GLM_API_KEY=your_glm_api_key_here

# ======================
# DeepXiv（MCP general.deepxiv：论文 / Web 搜索等）
# ======================
# 也可写在用户主目录 ~/.env；项目根 .env 优先被 Provider 加载（未覆盖已存在的环境变量）
# DEEPXIV_TOKEN=

# 下游 deep-search：本项目自托管 PubMed/Europe PMC MCP（docker compose 的 pubmed-mcp 服务）
# 先执行 ./scripts/setup-pubmed-mcp.sh，再执行 docker compose up -d pubmed-mcp。
# PubMed 召回的文献默认是 neutral；最终支持/反驳由后续 LLM 辅助、人工裁定。
# PTAGENT_DEEP_SEARCH__PROVIDER=pubmed
# PTAGENT_DEEP_SEARCH__LITERATURE_MCP_ENDPOINT=http://127.0.0.1:3010/mcp
# PTAGENT_DEEP_SEARCH__MCP_TOOL=pubmed_search_articles
# PTAGENT_DEEP_SEARCH__FETCH_MCP_TOOL=pubmed_fetch_articles
# PTAGENT_DEEP_SEARCH__MAX_RESULTS=5
# PTAGENT_DEEP_SEARCH__TIMEOUT_SECONDS=20
# PTAGENT_DEEP_SEARCH__MAX_ATTEMPTS=2
# PTAGENT_DEEP_SEARCH__RETRY_BACKOFF_SECONDS=1
# PTAGENT_DEEP_SEARCH__SOURCE_VERSION=pubmed-mcp-v2.9.8
# PTAGENT_DEEP_SEARCH__DEFAULT_STANCE=neutral

# 可选：NCBI API key 将请求上限从约 3 req/s 提升至约 10 req/s；email 用于 NCBI/EPMC 礼貌访问。
# NCBI_API_KEY=
# NCBI_ADMIN_EMAIL=you@example.org
# EUROPEPMC_EMAIL=you@example.org
# UNPAYWALL_EMAIL=you@example.org

# ======================
# 浏览器 CORS（前后端分端口时，可填边缘入口，逗号分隔）
# ======================
# PTAGENT_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ======================
# 仅给 PTAgent-frontend/edge 用（本服务器进程不读；边缘静态根目录）
# ======================
# PTAGENT_EDGE_BACKEND=http://127.0.0.1:8000
# PTAGENT_EDGE_PORT=8080
# PTAGENT_FRONTEND_DIR=/absolute/path/to/PTAgent-frontend/frontend

# ======================
# 统一 SQLite（Agent / Team / LLM 覆盖 / 模型扩展）
# ======================
# 项目根目录（容器请设为挂载卷，如 /var/lib/ptagent），默认 data/ptagent.db
# PTAGENT_PROJECT_ROOT=/path/to/PTAgent
# PTAGENT_DATABASE__SQLITE_PATH=data/ptagent.db
# 数据平面：保护 GET /ptagent-admin/api/data-plane/data-objects/{id}/path（本地解析路径）；不设置时开发态可不校验
# PTAGENT_INTERNAL_API_KEY=

# ======================
# Neo4j / 关系图谱（src/pkg/graph；需本机运行 Neo4j 且装 GDS 插件）
# ======================
# 不填则用默认值：bolt://127.0.0.1:7687 / neo4j / 空密码 / 库名 neo4j
# PTAGENT_GRAPH__URI=bolt://127.0.0.1:7687
# PTAGENT_GRAPH__USER=neo4j
# PTAGENT_GRAPH__PASSWORD=change_me
# PTAGENT_GRAPH__DATABASE=neo4j

# ===== 下游实验事实库（MySQL；与现有 SQLite Session/Run 并行） =====
# PTAGENT_EXPERIMENT_DATABASE__HOST=127.0.0.1
# PTAGENT_EXPERIMENT_DATABASE__PORT=3306
# PTAGENT_EXPERIMENT_DATABASE__USER=ptagent
# PTAGENT_EXPERIMENT_DATABASE__PASSWORD=change-me
# PTAGENT_EXPERIMENT_DATABASE__DATABASE=ptagent_experiment
# PTAGENT_EXPERIMENT_DATABASE__CHARSET=utf8mb4
# PTAGENT_EXPERIMENT_DATABASE__CONNECT_TIMEOUT_SECONDS=10
